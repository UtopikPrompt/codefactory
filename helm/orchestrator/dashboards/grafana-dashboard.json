{
  "$schema": "https://schemas.grafana.com/dashboards/1.0",
  "id": "cfe-orchestrator-monitoring",
  "uid": "cfe-orchestrator",
  "title": "GitHub Agent Orchestrator (CFE)",
  "tags": [
    "orchestrator",
    "cfe",
    "prometheus"
  ],
  "timezone": "browser",
  "refresh": "30s",
  "schemaVersion": 1,
  "editable": true,
  "annotations": {
    "enableThreshold": 5,
    "enableLabelThreshold": 5,
    "showUnread": false
  },
  "panels": [
    {
      "id": "0",
      "title": "Pipeline Overview",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "datasource": "${prometheus}",
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (role, outcome) (rate(orchestrator_agent_tasks_total[5m]))",
          "legendFormat": "{{role}} / {{outcome}} tasks/s"
        }
      ]
    },
    {
      "id": "1",
      "title": "Active Workload",
      "type": "gauge",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "datasource": "${prometheus}",
      "targets": [
        {
          "refId": "A",
          "expr": "orchestrator_active_tasks",
          "legendFormat": "supervisor active"
        },
        {
          "refId": "B",
          "expr": "gateway_tasks_by_status{status=\"queued\"}",
          "legendFormat": "queued"
        },
        {
          "refId": "C",
          "expr": "gateway_tasks_by_status{status=\"running\"}",
          "legendFormat": "running"
        }
      ]
    },
    {
      "id": "2",
      "title": "Gateway: Error Rate",
      "type": "timeseries",
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 0,
        "y": 8
      },
      "datasource": "${prometheus}",
      "targets": [
        {
          "refId": "A",
          "expr": "rate(http_request_errors_total[5m])",
          "legendFormat": "errors/s"
        }
      ]
    },
    {
      "id": "3",
      "title": "Gateway: Request Rate",
      "type": "timeseries",
      "gridPos": {
        "h": 6,
        "w": 4,
        "x": 8,
        "y": 8
      },
      "datasource": "${prometheus}",
      "targets": [
        {
          "refId": "A",
          "expr": "rate(http_requests_total[5m])",
          "legendFormat": "requests/s"
        }
      ]
    },
    {
      "id": "4",
      "title": "Gateway: Latency (s)",
      "type": "timeseries",
      "gridPos": {
        "h": 6,
        "w": 4,
        "x": 12,
        "y": 8
      },
      "datasource": "${prometheus}",
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, path) (rate(http_request_duration_seconds_bucket{method=\"GET\"}[5m])))",
          "legendFormat": "{{path}} p95 (s)"
        }
      ]
    },
    {
      "id": "5",
      "title": "Gateway: Tasks Accepted",
      "type": "timeseries",
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 0,
        "y": 14
      },
      "datasource": "${prometheus}",
      "targets": [
        {
          "refId": "A",
          "expr": "gateway_tasks_accepted_total",
          "legendFormat": "{{kind}}"
        }
      ]
    },
    {
      "id": "6",
      "title": "Supervisor: Best Score",
      "type": "timeseries",
      "gridPos": {
        "h": 6,
        "w": 4,
        "x": 8,
        "y": 14
      },
      "datasource": "${prometheus}",
      "targets": [
        {
          "refId": "A",
          "expr": "orchestrator_best_score",
          "legendFormat": "best eval score"
        }
      ]
    },
    {
      "id": "7",
      "title": "Supervisor: Current Iteration",
      "type": "timeseries",
      "gridPos": {
        "h": 6,
        "w": 4,
        "x": 12,
        "y": 14
      },
      "datasource": "${prometheus}",
      "targets": [
        {
          "refId": "A",
          "expr": "orchestrator_current_iteration",
          "legendFormat": "current iteration"
        }
      ]
    },
    {
      "id": "8",
      "title": "Supervisor: Supervisor State",
      "type": "timeseries",
      "gridPos": {
        "h": 6,
        "w": 4,
        "x": 0,
        "y": 20
      },
      "datasource": "${prometheus}",
      "targets": [
        {
          "refId": "A",
          "expr": "orchestrator_supervisor_state",
          "legendFormat": "state"
        }
      ]
    },
    {
      "id": "9",
      "title": "Supervisor: Active Tasks",
      "type": "timeseries",
      "gridPos": {
        "h": 6,
        "w": 4,
        "x": 4,
        "y": 20
      },
      "datasource": "${prometheus}",
      "targets": [
        {
          "refId": "A",
          "expr": "gateway_tasks_by_status{status=\"running\"}",
          "legendFormat": "durable tasks running"
        }
      ]
    },
    {
      "id": "10",
      "title": "Worker: Code Changes",
      "type": "timeseries",
      "gridPos": {
        "h": 6,
        "w": 4,
        "x": 8,
        "y": 20
      },
      "datasource": "${prometheus}",
      "targets": [
        {
          "refId": "A",
          "expr": "rate(worker_code_changes_total[5m])",
          "legendFormat": "code changes/s"
        }
      ]
    },
    {
      "id": "11",
      "title": "Agent Tasks: Cumulative Outcomes",
      "type": "timeseries",
      "gridPos": {
        "h": 6,
        "w": 4,
        "x": 12,
        "y": 20
      },
      "datasource": "${prometheus}",
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (role, outcome) (orchestrator_agent_tasks_total)",
          "legendFormat": "{{role}} / {{outcome}}"
        }
      ]
    },
    {
      "id": "12",
      "title": "Agent Task Attempt Duration (s)",
      "type": "timeseries",
      "gridPos": {
        "h": 6,
        "w": 4,
        "x": 0,
        "y": 26
      },
      "datasource": "${prometheus}",
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum by (le, role) (rate(orchestrator_agent_task_attempt_duration_seconds_bucket[5m])))",
          "legendFormat": "{{role}} p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le, role) (rate(orchestrator_agent_task_attempt_duration_seconds_bucket[5m])))",
          "legendFormat": "{{role}} p95"
        }
      ]
    },
    {
      "id": "13",
      "title": "Worker: Active Jobs",
      "type": "timeseries",
      "gridPos": {
        "h": 6,
        "w": 4,
        "x": 4,
        "y": 26
      },
      "datasource": "${prometheus}",
      "targets": [
        {
          "refId": "A",
          "expr": "worker_active_jobs",
          "legendFormat": "active jobs"
        }
      ]
    },
    {
      "id": "14",
      "title": "Worker: Last Outcome",
      "type": "timeseries",
      "gridPos": {
        "h": 6,
        "w": 4,
        "x": 8,
        "y": 26
      },
      "datasource": "${prometheus}",
      "targets": [
        {
          "refId": "A",
          "expr": "worker_last_status",
          "legendFormat": "{{role}} / {{outcome}}"
        }
      ]
    },
    {
      "id": "15",
      "title": "Tasks: Current State",
      "type": "timeseries",
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 0,
        "y": 32
      },
      "datasource": "${prometheus}",
      "targets": [
        {
          "refId": "A",
          "expr": "gateway_tasks_by_status",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "id": "16",
      "title": "Agent Task Outcomes (Selected Range)",
      "type": "stat",
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 12,
        "y": 32
      },
      "datasource": "${prometheus}",
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (role, outcome) (increase(orchestrator_agent_tasks_total[$__range]))",
          "legendFormat": "{{role}} / {{outcome}}"
        }
      ]
    },
    {
      "id": "17",
      "title": "Model Tokens Used (Selected Range)",
      "type": "timeseries",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 38
      },
      "datasource": "${prometheus}",
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (role, direction) (increase(worker_model_tokens_total[$__range]))",
          "legendFormat": "{{role}} / {{direction}}"
        }
      ]
    },
    {
      "id": "18",
      "title": "Worker Output Throughput (tokens/s)",
      "type": "timeseries",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 38
      },
      "datasource": "${prometheus}",
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum by (le, role) (rate(worker_output_tokens_per_second_bucket[5m])))",
          "legendFormat": "{{role}} p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le, role) (rate(worker_output_tokens_per_second_bucket[5m])))",
          "legendFormat": "{{role}} p95"
        }
      ]
    },
    {
      "id": "19",
      "title": "Prometheus Scrape Health",
      "type": "timeseries",
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 0,
        "y": 45
      },
      "datasource": "${prometheus}",
      "targets": [
        {
          "refId": "A",
          "expr": "up",
          "legendFormat": "{{job}} / {{instance}}"
        }
      ]
    },
    {
      "id": "20",
      "title": "Gateway Error Rate",
      "type": "timeseries",
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 12,
        "y": 45
      },
      "datasource": "${prometheus}",
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (path) (rate(http_request_errors_total[5m]))",
          "legendFormat": "{{path}} errors/s"
        }
      ]
    },
    {
      "id": "21",
      "title": "Worker: Model Preparation Wait (s)",
      "description": "Client-observed time spent polling and requesting model preparation; this is not inference-server internal loading time.",
      "type": "timeseries",
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 0,
        "y": 51
      },
      "datasource": "${prometheus}",
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum by (le, role) (rate(worker_model_preparation_duration_seconds_bucket[5m])))",
          "legendFormat": "{{role}} p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le, role) (rate(worker_model_preparation_duration_seconds_bucket[5m])))",
          "legendFormat": "{{role}} p95"
        }
      ]
    }
  ],
  "templating": {
    "list": [
      {
        "name": "prometheus",
        "type": "datasource",
        "query": "prometheus",
        "refresh": 1,
        "regex": "",
        "hide": 0,
        "multi": false,
        "includeAll": false,
        "current": {},
        "options": []
      }
    ]
  },
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "30s"
}